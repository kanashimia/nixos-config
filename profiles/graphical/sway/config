seat * {
    xcursor_theme Adwaita 24
    # hide_cursor 5000
}

floating_modifier $mod normal

bindsym --no-repeat --whole-window {
    BTN_EXTRA exec wpctl set-mute @DEFAULT_SOURCE@ 0
    BTN_SIDE  exec wpctl set-mute @DEFAULT_SOURCE@ 1
}

bindsym --to-code {
    $mod+Shift+0 input type:keyboard xkb_layout "us"
    $mod+0 input type:keyboard xkb_layout $layout
    $mod+F10 input type:keyboard xkb_options $options

    $mod+F1 input type:keyboard xkb_switch_layout 0
    $mod+F2 input type:keyboard xkb_switch_layout 1
    $mod+F3 input type:keyboard xkb_switch_layout 2
    $mod+F4 input type:keyboard xkb_switch_layout 3
    $mod+F5 input type:keyboard xkb_switch_layout 4

    $mod+Shift+c kill

    $mod+q       reload
    $mod+Shift+q exit

    $mod+$left  focus left
    $mod+$down  focus down
    $mod+$up    focus up
    $mod+$right focus right

    $mod+a mark --replace swap
    $mod+Shift+a swap container with mark swap

    $mod+Shift+$left  move left  100px
    $mod+Shift+$down  move down  100px
    $mod+Shift+$up    move up    100px
    $mod+Shift+$right move right 100px

    $mod+1 workspace number 1
    $mod+2 workspace number 2
    $mod+3 workspace number 3
    $mod+4 workspace number 4
    $mod+5 workspace number 5
    $mod+6 workspace number 6
    $mod+7 workspace number 7
    $mod+8 workspace number 8
    $mod+9 workspace number 9

    $mod+Shift+1 move to workspace number 1
    $mod+Shift+2 move to workspace number 2
    $mod+Shift+3 move to workspace number 3
    $mod+Shift+4 move to workspace number 4
    $mod+Shift+5 move to workspace number 5
    $mod+Shift+6 move to workspace number 6
    $mod+Shift+7 move to workspace number 7
    $mod+Shift+8 move to workspace number 8
    $mod+Shift+9 move to workspace number 9
    
    $mod+Shift+Right move workspace to output right
    $mod+Shift+Left  move workspace to output left
    $mod+Shift+Down  move workspace to output down
    $mod+Shift+Up    move workspace to output up

    $mod+g       resize grow   width  100px
    $mod+s       resize shrink width  100px
    $mod+Shift+g resize grow   height 100px
    $mod+Shift+s resize shrink height 100px

    $mod+b split h
    $mod+v split v

    $mod+t layout toggle
    $mod+Shift+n layout toggle stacking tabbed split
    $mod+f fullscreen

    $mod+p focus parent
    $mod+c focus child
    
    $mod+n split none

    $mod+Shift+m floating toggle
    $mod+m       focus mode_toggle

    $mod+Shift+minus move scratchpad
    $mod+minus       scratchpad show
}

bindsym --to-code {
    $mod+Return       $exec $term
    $mod+Shift+Return $exec $term -D "$(swaycwd 2> /dev/null)"

    $mod+r $exec $wofi 
    $mod+Shift+r $exec $commands

    $mod+Shift+e exec $restarter
    $mod+Shift+b $exec $browser
    $mod+Shift+t $exec $telegram; [app_id="org.telegram.desktop"] move to workspace current

    Print       exec grim -c - | wl-copy -t image/png
    Shift+Print exec systemd-run --user --scope --quiet -u screenshot -- slurp | grim -g - - | wl-copy -t image/png
    $mod+Print  exec ~/screenshot.sh

    XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_SINK@ -l 1.0 5%+
    XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_SINK@ -l 1.0 5%-
    XF86AudioMute        exec wpctl set-mute   @DEFAULT_SINK@ toggle

    XF86MonBrightnessUp   exec brightnessctl set --quiet --exponent 5%+
    XF86MonBrightnessDown exec brightnessctl set --quiet --exponent 5%-
}

