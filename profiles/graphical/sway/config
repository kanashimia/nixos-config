set {
    $mod Mod4
    $layout "us(dvorak),ru,ua,us"
    $options "grp_led:num,grp:rctrl_rshift_toggle,compose:menu,compose:rctrl"
    # ,custom:ralt_as_lalt

    $left h
    $down j
    $up k
    $right l

    $apps /run/current-system/sw/share/applications

    # $term footclient -E
    $term foot
    $browser chromium
    # $browser "librewolf"
    # $browser "firefox-devedition"
    # $browser "librewolf", exec "~/fixupbrowser.sh"
# for_window [app_id="^firefox$" title="^Extension: "] exec "sleep 0.1; swaymsg floating enable; swaymsg floating disable; swaymsg floating enable"
    # $telegram Telegram
    $telegram gio launch $apps/org.telegram.desktop.desktop
    # $exec exec ~/run.sh
    # $exec exec ~/trash/runc/slicerun
    $exec exec
    $wofi wofi --show drun --insensitive --allow-images
    $commands ~/documents/scripts/commands.sh
    $restarter ~/documents/scripts/restarter.sh
}

