input type:keyboard {
    xkb_layout $layout
    xkb_options $options
}

input 1:1:AT_Translated_Set_2_keyboard {
    xkb_options $options,caps:escape,altwin:swap_lalt_lwin
}

input type:touchpad {
    tap enable
    dwt disable
    natural_scroll enable
    # events disabled
}

input type:pointer {
    accel_profile flat
    pointer_accel -0.7
}

input type:tablet_tool {
    map_from_region 0.0x0.0 1.0x0.96
    # tool_mode * relative
    # accel_profile adaptive
}

